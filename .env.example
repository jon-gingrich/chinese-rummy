# Copy to .env.local and fill in after running `npx convex dev`

NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Convex Auth base keys — set on deployment by:
#   npx @convex-dev/auth --web-server-url http://localhost:3000 --skip-git-check
# (SITE_URL, JWT_PRIVATE_KEY, JWKS)

# Provider secrets — set on deployment via scripts/setup-auth-providers.ps1
# or `npx convex env set`. See docs/setup/auth-providers.md.
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
# AUTH_RESEND_KEY=...
# AUTH_EMAIL_FROM="Chinese Rummy <onboarding@resend.dev>"
