# JWKS=...
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
# AUTH_RESEND_KEY=...
# AUTH_EMAIL_FROM="Chinese Rummy <onboarding@yourdomain.com>"
