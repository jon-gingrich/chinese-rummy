    "@tailwindcss/postcss": "^4.3.2",
    "convex": "^1.42.1",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "convex-test": "^0.0.54",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.10",
